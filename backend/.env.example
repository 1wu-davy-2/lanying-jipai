APP_ENV=development
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DB_NAME?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
AES_KEY=replace-with-a-32-byte-base64-encoded-key
UPLOADS_DIR=/opt/lanying-jipai/backend/uploads

# local (development) or cos (production)
UPLOAD_STORAGE_DRIVER=local

# Tencent COS primary storage. COS objects are public-read; write credentials stay on the server.
COS_BUCKET=example-1250000000
COS_REGION=ap-guangzhou
COS_SECRET_ID=replace-with-cos-secret-id
COS_SECRET_KEY=replace-with-cos-secret-key
# Use a COS custom domain or CDN domain in production. Leave empty to use the COS regional domain.
COS_PUBLIC_BASE_URL=https://example-1250000000.cos.ap-guangzhou.myqcloud.com

# MinIO is backup-only and is never returned to the browser. The endpoint has no http(s) scheme.
MINIO_ENDPOINT=minio.internal.example:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=lanying-media-backup
MINIO_SECURE=true
MEDIA_BACKUP_RETRY_BASE_MINUTES=15
