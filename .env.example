# Docker Compose project name and the host port the frontend is exposed on.
COMPOSE_PROJECT_NAME=lanying-jipai
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# External MariaDB — Compose does not create or manage this database.
# Create the database manually before first startup:
#   CREATE DATABASE lanying_jipai CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# ---------------------------------------------------------------------------
# Example: mysql+pymysql://lanying:lanying123@192.168.1.100:3306/lanying_jipai?charset=utf8mb4
DATABASE_URL=mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:3306/YOUR_DB_NAME?charset=utf8mb4

# ---------------------------------------------------------------------------
# Backend secrets — generate before first startup:
#   JWT_SECRET_KEY: python3 -c "import secrets; print(secrets.token_hex(32))"
#   AES_KEY:        python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
APP_ENV=production
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
AES_KEY=replace-with-a-32-byte-base64-key

# CORS allowed origins.
# Test environment — allow all origins:
#   CORS_ORIGINS=*
# Production — list specific origins (comma-separated):
#   CORS_ORIGINS=http://192.168.1.100:5173,capacitor://localhost
CORS_ORIGINS=*

WEB_CONCURRENCY=2

# ---------------------------------------------------------------------------
# External MinIO — Compose does not create or manage this service.
# MINIO_SECURE=false  when the backend reaches MinIO over plain HTTP (typical on internal networks).
# MINIO_PUBLIC_BASE_URL is the URL the *browser* uses to load media files.
#   If MinIO is not behind a reverse proxy use the raw HTTP endpoint, e.g.:
#   http://192.168.1.100:9000/lanying-media
# ---------------------------------------------------------------------------
UPLOAD_STORAGE_DRIVER=minio
MINIO_ENDPOINT=192.168.1.100:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=lanying-media
MINIO_SECURE=false
MINIO_PUBLIC_BASE_URL=http://192.168.1.100:9000/lanying-media

# ---------------------------------------------------------------------------
# Bootstrap administrator — created once when no matching user exists.
# Default credentials: 11111111112 / admin@123  (change password after first login).
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_PHONE=11111111112
BOOTSTRAP_ADMIN_PASSWORD=admin@123
BOOTSTRAP_ADMIN_NICKNAME=超级管理员
