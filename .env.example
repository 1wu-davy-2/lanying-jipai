# Docker Compose project and public frontend port.
COMPOSE_PROJECT_NAME=lanying-jipai
FRONTEND_PORT=5173

# MariaDB is internal to Docker. Use URL-safe passwords: letters, digits, _, -, and .
MYSQL_DATABASE=lanying_jipai
MYSQL_USER=lanying_app
MYSQL_PASSWORD=replace-with-a-long-url-safe-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-url-safe-root-password

# Backend application secrets. Generate them with the commands in docs/12-docker-compose-test-deployment.md.
APP_ENV=production
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
AES_KEY=replace-with-a-32-byte-base64-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_STORAGE_DRIVER=local
WEB_CONCURRENCY=2

# This account is created only when the database has no matching user. Change it before first startup.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_PHONE=10000000000
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_NICKNAME=测试管理员
